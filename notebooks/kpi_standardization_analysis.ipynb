{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 📐 KPI Definition, Standardization & Validation Framework\n",
        "\n",
        "## Executive Summary\n",
        "Discrepancies across Finance (50,000 users), Sales (35,000 users), and Product (28,000 users) stem from unaligned KPI definitions. This notebook establishes a single source of truth: formal KPI reference definitions, standardized Python calculation functions, target validation checks, and hierarchical KPI decompositions."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "import json\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Add root directory to sys.path\n",
        "sys.path.append(os.path.abspath('..'))\n",
        "\n",
        "from kpis.kpi_functions import (\n",
        "    calculate_mau,\n",
        "    calculate_revenue_per_customer,\n",
        "    calculate_churn_rate,\n",
        "    calculate_payment_success_rate,\n",
        "    calculate_customer_acquisition_cost,\n",
        "    calculate_total_revenue,\n",
        "    format_kpi_value\n",
        ")\n",
        "from scripts.kpi_standardization_assignment import generate_transaction_dataset\n",
        "\n",
        "df = generate_transaction_dataset()\n",
        "df.head()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Task 1: Define KPI Reference Document (1 mark)\n",
        "Load formal KPI metadata definitions from `kpis/kpi_reference.md`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "kpi_ref_path = os.path.join('..', 'kpis', 'kpi_reference.md')
with open(kpi_ref_path, 'r', encoding='utf-8') as f:
    ref_markdown = f.read()

print("Formal KPI Reference Document loaded successfully. Preview:")
print(ref_markdown[:600] + "\n...")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Task 2: Implement KPI Computation Functions (1 mark)\n",
        "Compute metrics using standardized reusable functions from `kpis/kpi_functions.py`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "mau = calculate_mau(df, days=30)\n",
        "rpc = calculate_revenue_per_customer(df)\n",
        "churn = calculate_churn_rate(df, period_days=30)\n",
        "payment_success = calculate_payment_success_rate(df)\n",
        "cac = calculate_customer_acquisition_cost(total_marketing_spend=189700.0, new_customers_acquired=5420)\n",
        "total_rev = calculate_total_revenue(df)\n",
        "\n",
        "print(f\"MAU: {format_kpi_value('mau', mau)}\")\n",
        "print(f\"Revenue per Customer: {format_kpi_value('rpc', rpc)}\")\n",
        "print(f\"Churn Rate: {format_kpi_value('churn', churn)}\")\n",
        "print(f\"Payment Success Rate: {format_kpi_value('rate', payment_success)}\")\n",
        "print(f\"CAC: {format_kpi_value('cac', cac)}\")\n",
        "print(f\"Total Revenue: {format_kpi_value('total_revenue', total_rev)}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Task 3: Validate Against Targets (1 mark)\n",
        "Compare computed KPIs against target bounds from `kpis/kpi_validation_targets.json`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "with open(os.path.join('..', 'kpis', 'kpi_validation_targets.json'), 'r') as f:\n",
        "    targets = json.load(f)\n",
        "\n",
        "current_kpis = {\n",
        "    'mau': mau,\n",
        "    'revenue_per_customer': rpc,\n",
        "    'churn_rate': churn,\n",
        "    'payment_success_rate': payment_success,\n",
        "    'customer_acquisition_cost': cac,\n",
        "    'total_revenue': total_rev\n",
        "}\n",
        "\n",
        "validation_report = []\n",
        "for kpi_name, target_range in targets.items():\n",
        "    actual = current_kpis[kpi_name]\n",
        "    min_val = target_range['min']\n",
        "    max_val = target_range['max']\n",
        "    \n",
        "    status = 'PASS' if min_val <= actual <= max_val else 'ALERT'\n",
        "    validation_report.append({\n",
        "        'kpi': kpi_name,\n",
        "        'actual': format_kpi_value(kpi_name, actual),\n",
        "        'target_min': min_val,\n",
        "        'target_max': max_val,\n",
        "        'status': status\n",
        "    })\n",
        "\n",
        "validation_df = pd.DataFrame(validation_report)\n",
        "display(validation_df)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Task 4: KPI Decomposition (1 mark)\n",
        "Decompose Top-Level Revenue down to Segment Level and Product Tier Level."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "df_success = df[df['payment_status'] == 'SUCCESS']\n",
        "total_revenue = df_success['amount'].sum()\n",
        "revenue_by_segment = df_success.groupby('customer_type')['amount'].sum()\n",
        "revenue_by_product = df_success.groupby('product')['amount'].sum()\n",
        "\n",
        "print(f\"\"\"\n",
        "KPI DECOMPOSITION: Total Monthly Revenue\n",
        "\n",
        "Level 1 (Top-level): ${total_revenue:,.2f}\n",
        "\n",
        "Level 2 (By Segment):\n",
        "  Enterprise: ${revenue_by_segment.get('Enterprise', 0):,.2f}\n",
        "  SMB:        ${revenue_by_segment.get('SMB', 0):,.2f}\n",
        "  Startup:    ${revenue_by_segment.get('Startup', 0):,.2f}\n",
        "\n",
        "Level 3 (By Product):\n",
        "{revenue_by_product.to_string()}\n",
        "\"\"\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Task 5: Commit KPI Reference and Functions (1 mark)\n",
        "Verify module importability and directory organization."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from kpis.kpi_functions import calculate_mau\n",
        "mau_test = calculate_mau(df)\n",
        "print(f\"Import verification successful! Calculated MAU: {mau_test:,} users\")"
      ]
    }
